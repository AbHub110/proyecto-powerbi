table index_coffee
	lineageTag: ba68a9ad-73be-4520-adbb-b6aebe88f613

	measure 'Total Ingresos' =
			
			SUM('index_coffee'[money])
		formatString: 0
		lineageTag: 5487116c-8ca0-4f20-8649-6eca25d5a12e

	measure Ventas = sum('index_coffee'[money])
		formatString: 0
		lineageTag: 46c679b7-79a7-4b5a-9cf8-03b964c81870

	measure 'Total Transacciones' =
			
			COUNT(index_coffee[cash_type])
		formatString: 0
		lineageTag: 13bb592a-8583-4ae6-9d28-1f935b4f9cfc

	measure 'Ticket Promedio' =
			
			DIVIDE([Total Ingresos], [Total Transacciones], 0)
		lineageTag: f5b365b7-7478-4012-a0c8-b4ba5d64a8f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clientes Unicos' =
			
			DISTINCTCOUNT('index_coffee'[card])
		formatString: 0
		lineageTag: 13d4ddc8-53d1-4533-8109-61855ed1d44b

	measure 'Ingresos por Tarjeta' =
			
			CALCULATE(
			    [Total Ingresos],
			    'index_coffee'[cash_type] = "card"
			)
		formatString: 0
		lineageTag: 12ed890c-baad-4c6c-8321-5a4ea7d988ea

	measure 'Ingresos por Efectivo' =
			
			CALCULATE(
			    [Total Ingresos],
			    'index_coffee'[cash_type] = "cash"
			)
		formatString: 0
		lineageTag: aa349a2a-adf4-4db0-b33d-8bb4955f42c7

	measure '% Ventas Tarjeta' =
			
			DIVIDE([Ingresos por Tarjeta], [Total Ingresos], 0)
		lineageTag: a3870056-51a5-43f5-99df-e588a0d6f9b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Producto Mas Vendido' = ```
			
			TOPN(
			    1, 
			    VALUES('index_coffee'[coffee_name]), 
			    [Total Transacciones], 
			    DESC
			)
			```
		lineageTag: e6cc6db2-aeaa-4a78-955d-4f1dc29529b6

	measure 'Promedio Gasto por Cliente' =
			
			DIVIDE([Ingresos por Tarjeta], [Clientes Unicos], 0)
		lineageTag: 232585ee-d5ef-41c4-95c2-b5a8929cbc09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

