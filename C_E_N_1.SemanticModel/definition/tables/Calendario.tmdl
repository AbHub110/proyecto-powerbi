			defaultHierarchy: LocalDateTable_20aafce3-a1d6-4e93-9295-60efcecf3eb9.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source = ```
				
				CALENDAR(
				    MIN('index_coffee'[date]), 
				    MAX('index_coffee'[date])
				)
				```

	annotation PBI_Id = 38883f91117e42cea1d3f96564d05971

