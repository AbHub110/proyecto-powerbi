table Calendario
	lineageTag: 7d25c75d-2e55-48e8-b79d-3f8b320eb30a

	measure 'Ingresos YTD' =
			
			TOTALYTD([Total Ingresos], 'Calendario'[Date])
		formatString: 0
		lineageTag: bdf9fe57-71de-4ad3-a47b-3edd2148472a

	measure 'Ingresos Mes Anterior' = ```
			
			CALCULATE(
			    [Total Ingresos], 
			    DATEADD('Calendario'[Date], -1, MONTH)
			)
			```
		formatString: 0
		lineageTag: 43a6894a-8296-46b0-bc46-4a6a7407072f

	column Date
		formatString: General Date
		lineageTag: 84454e88-a426-4b39-a68b-366560d8f03b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variación
